-- This function takes a string of text and replaces some chars with visually
-- similar unicode equivalent characters from the Greek, Cyrillic, or Armenian
-- unicode block sets. These replacement chars are from other collations, which
-- frustrates interpretation by Natural Language Processing algorithms and search
-- indices.

CREATE OR ALTER FUNCTION dbo.fn_camouflage
  (
    @input VARCHAR(8000)
  )
  RETURNS NVARCHAR(MAX)
  WITH SCHEMABINDING
AS
BEGIN

--declare @input varchar(8000) = 'The quick brown fox jumps over the lazy dog.'
declare @output nvarchar(max) = N'';
declare @i int= 1;
declare @x varchar(1);
declare @y nvarchar(2);
declare @z float;
declare @camouflage table
  (
    unicode tinyint
   ,latin   as cast(char(unicode) as char(1)) COLLATE SQL_Latin1_General_CP1_CS_AS
   ,greek   as cast(case when unicode = 65
                         then nchar(913)
                         when unicode = 66
                         then nchar(914)
                         --when unicode = 67
                         --then nchar(1017)
                         when unicode = 69
                         then nchar(917)
                         when unicode = 72
                         then nchar(919)
                         when unicode = 73
                         then nchar(921)
                         when unicode = 75
                         then nchar(922)
                         when unicode = 77
                         then nchar(924)
                         when unicode = 78
                         then nchar(925)
                         when unicode = 79
                         then nchar(927)
                         when unicode = 80
                         then nchar(929)
                         when unicode = 84
                         then nchar(932)
                         when unicode = 88
                         then nchar(935)
                         when unicode = 89
                         then nchar(933)
                         when unicode = 90
                         then nchar(918)
                         when unicode = 111
                         then nchar(959)
                         end
                    as nvarchar(2))
   ,cyrillic as cast(case when unicode = 65
                         then nchar(1040)
                         when unicode = 66
                         then nchar(1042)
                         when unicode = 67
                         then nchar(1057)
                         when unicode = 69
                         then nchar(1045)
                         when unicode = 73
                         then nchar(1030)
                         when unicode = 74
                         then nchar(1032)
                         when unicode = 75
                         then nchar(1050)
                         when unicode = 77
                         then nchar(1052)
                         when unicode = 79
                         then nchar(1054)
                         when unicode = 80
                         then nchar(1056)
                         --when unicode = 81
                         --then nchar(1306)
                         when unicode = 83
                         then nchar(1029)
                         when unicode = 84
                         then nchar(1058)
                         when unicode = 87
                         then nchar(1308)
                         when unicode = 97
                         then nchar(1072)
                         when unicode = 99
                         then nchar(1089)
                         when unicode = 101
                         then nchar(1077)
                         when unicode = 105
                         then nchar(1110)
                         when unicode = 106
                         then nchar(1112)
                         when unicode = 111
                         then nchar(1086)
                         when unicode = 112
                         then nchar(1088)
                         --when unicode = 113
                         --then nchar(1307)
                         when unicode = 115
                         then nchar(1109)
                         when unicode = 119
                         then nchar(1309)
                         when unicode = 120
                         then nchar(1093)
                         when unicode = 121
                         then nchar(1091)
                         end
                    as nvarchar(2))
   ,armenian as cast(case --when unicode = 85
                          --then nchar(1357)
                          --when unicode = 117
                          --then nchar(1405)
                          WHEN 1=2
                          then ''
                          end
                     as nvarchar(2))
  );
with cte_sequencer as
(
    select 1 as unicode
    union ALL
    select unicode + 1
    from cte_sequencer
    where unicode < 122
)
insert into @camouflage (unicode)
select unicode
from cte_sequencer
where unicode <= 122
  and (   unicode between 48 and 57
       or unicode between 65 and 90
       or unicode between 97 and 122)
option (maxrecursion 122);

while @i <= (select len(@input))
begin
    set @x = (select substring(@input,@i,1));
    set @z = @i % 2
    if @z < 0.5
        set @y = (
                  select isnull(value,latin)
                  from (
                        select t1.latin, value
                              ,rowID = row_number() over(partition by t1.unicode order by Block ASC)
                        from @camouflage as t1
                            left join (
                                       select unicode, latin, Block, Value
                                       from (
                                             select unicode, latin, greek, cyrillic, armenian
                                             from @camouflage
                                            ) as dat
                                        unpivot (
                                                 Value for Block in
                                                       (
                                                        greek,cyrillic,armenian)
                                                       ) as unpvt
                                                ) as t2
                                on t1.unicode = t2.unicode
                        where t1.latin = @x
                       ) as src
                  where rowID = 1
                 )
        else
        set @y = (
                  select isnull(value,latin)
                  from (
                        select t1.latin, value
                              ,rowID = row_number() over(partition by t1.unicode order by Block DESC)
                        from @camouflage as t1
                            left join (
                                       select unicode, latin, Block, Value
                                       from (
                                             select unicode, latin, greek, cyrillic, armenian
                                             from @camouflage
                                            ) as dat
                                        unpivot (
                                                 Value for Block in
                                                       (
                                                        greek,cyrillic,armenian)
                                                       ) as unpvt
                                                ) as t2
                                on t1.unicode = t2.unicode
                        where t1.latin = @x
                       ) as src
                  where rowID = 1
                 )
    set @y = coalesce(@y,@x)
    set @output = @output + @y;
    set @i += 1;
    if @i > (select len(@input))
        break;
    else
        continue;
end

RETURN @output

/*
  -- Copy/paste output to a text editor. Search for the vowels (A/E/I/O/U/a/e/i/o/u). They cannot be found.
  declare @input nvarchar(max) = substring('Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.',1,4000)
  select @input as [input], dbo.fn_camouflage(@input) as [output];
*/

END
